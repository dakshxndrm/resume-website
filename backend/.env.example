# Postgres — Supabase/Neon free tier connection string
DATABASE_URL=postgresql://user:password@localhost:5432/resumeai
# Path to Firebase service account JSON (Firebase console > Project settings > Service accounts)
FIREBASE_CREDENTIALS=./firebase-service-account.json
# CORS
FRONTEND_ORIGIN=http://localhost:3000
# LLM keys (Phase 1) — Gemini primary, Groq fallback
# GEMINI_API_KEY is read into settings but not wired to any code yet.
GEMINI_API_KEY=
GROQ_API_KEY=
# Groq model for AI suggestions — change here if Groq retires the default
GROQ_MODEL=llama-3.3-70b-versatile

# --- LLM cost control (Phase 1 free-tier protection) ---
# Daily LLM calls per signed-in user. The suggestion cache absorbs repeats, so
# this only counts genuinely new (resume, job description) pairs.
LLM_DAILY_LIMIT_USER=30
# Daily LLM calls for anonymous callers, bucketed by IP. Deliberately small:
# the Groq free tier is one shared quota for the whole site.
LLM_DAILY_LIMIT_ANON=5
# How long cached suggestions stay valid, in hours. 720 = 30 days.
SUGGESTION_CACHE_TTL_HOURS=720
