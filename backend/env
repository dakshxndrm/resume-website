# ============================================================
#  backend/.env  —  your private settings. NOT shared, NOT committed to git.
# ============================================================

# --- Database (Neon Postgres) ---
# Paste YOUR Neon connection string below, replacing the whole placeholder line.
# It must start with postgresql://  and usually ends with ?sslmode=require
DATABASE_URL=REPLACE_WITH_YOUR_NEON_CONNECTION_STRING

# --- CORS: which frontend is allowed to call this backend ---
FRONTEND_ORIGIN=http://localhost:3000

# --- Firebase (login) — leave blank for now, we'll set this up later ---
FIREBASE_CREDENTIALS=./firebase-service-account.json

# --- LLM keys — leave blank for now (these are for P3) ---
GEMINI_API_KEY=
GROQ_API_KEY=
